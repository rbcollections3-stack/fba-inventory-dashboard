# Copy this file to .env.local for running on your own computer.
# On Vercel, enter these under Project Settings > Environment Variables.
# Never commit real values: this repository is public.

# Postgres connection string. On Supabase use the "Transaction pooler" string
# (port 6543) from Project Settings > Database > Connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fba_dev

# A long random string used to sign logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# The first admin and first warehouse staff logins are created from these the
# first time someone logs in. Each must be at least 12 characters with a special
# character, and must not contain the username. Both people choose their own
# password and set up an authenticator app at their first login, so these are
# only used once. Add more staff logins on the Accounts screen.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
STAFF_USERNAME=warehouse
STAFF_PASSWORD=
