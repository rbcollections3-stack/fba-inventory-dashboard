# Copy this file to .env.local for running on your own computer.
# On Vercel, enter these under Project Settings > Environment Variables.
# Never commit real values: this repository is public.

# Postgres connection string. On Supabase use the "Transaction pooler" string
# (port 6543) from Project Settings > Database > Connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fba_dev

# A long random string used to sign logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# The first admin and first warehouse staff logins are created from these the
# first time someone logs in. Each must be at least 12 characters with a special
# character, and must not contain the username. Both people choose their own
# password and set up an authenticator app at their first login, so these are
# only used once. Add more staff logins on the Accounts screen.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
STAFF_USERNAME=warehouse
STAFF_PASSWORD=

# Optional. The time zone used for "today" on stock counts. Defaults to
# America/Los_Angeles (Pacific), which Amazon's US reports use.
# BUSINESS_TIME_ZONE=America/New_York

# Amazon Selling Partner API (Phase 3, automatic daily reports). Read-only.
# Use the keys from your Seller Central app. See "Connect Amazon" in SETUP.md.
# On Vercel mark these as Sensitive. Leave blank to keep uploading by hand.
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
# Vercel sends this with each scheduled run so only Vercel can start the pull.
# 32 or more random letters and numbers.
CRON_SECRET=
# Optional. Defaults: Amazon.com US (ATVPDKIKX0DOER), North America endpoint (na).
# Canada is A2EUQ1WTGCTBG2 on the same na endpoint (not used yet).
# SP_API_MARKETPLACE_ID=ATVPDKIKX0DOER
# SP_API_REGION=na
